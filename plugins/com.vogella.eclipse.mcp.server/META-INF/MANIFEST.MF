Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Eclipse MCP Server
Bundle-SymbolicName: com.vogella.eclipse.mcp.server;singleton:=true
Bundle-Version: 2.0.0.qualifier
Bundle-Vendor: vogella GmbH
Bundle-RequiredExecutionEnvironment: JavaSE-25
Bundle-ActivationPolicy: lazy
Automatic-Module-Name: com.vogella.eclipse.mcp.server
Require-Bundle: org.eclipse.core.runtime;bundle-version="3.31.0",
 com.vogella.eclipse.mcp.core;bundle-version="1.0.0"
Import-Package: com.networknt.schema;version="[3.0,4)",
 com.networknt.schema.dialect;version="[3.0,4)",
 io.modelcontextprotocol.json;version="[2.0,3)",
 io.modelcontextprotocol.json.jackson3;version="[2.0,3)",
 io.modelcontextprotocol.json.schema;version="[2.0,3)",
 io.modelcontextprotocol.server;version="[2.0,3)",
 io.modelcontextprotocol.server.transport;version="[2.0,3)",
 io.modelcontextprotocol.spec;version="[2.0,3)",
 jakarta.servlet;version="[6.1,7)",
 jakarta.servlet.http;version="[6.1,7)",
 org.eclipse.jetty.ee11.servlet;version="[12.1.12,13)",
 org.eclipse.jetty.server;version="[12.1.12,13)",
 org.eclipse.jetty.util.thread;version="[12.1.12,13)",
 org.eclipse.osgi.service.datalocation;version="1.4.0",
 org.osgi.framework;version="[1.10,2)",
 tools.jackson.databind;version="[3.0,4)",
 tools.jackson.databind.json;version="[3.0,4)"
Export-Package: com.vogella.eclipse.mcp.server,
 com.vogella.eclipse.mcp.server.internal;x-friends:="com.vogella.eclipse.mcp.server.tests"
Service-Component: OSGI-INF/com.vogella.eclipse.mcp.server.internal.McpServerComponent.xml
