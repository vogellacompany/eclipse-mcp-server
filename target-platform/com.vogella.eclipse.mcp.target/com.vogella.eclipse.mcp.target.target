<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>
<target name="com.vogella.eclipse.mcp.target" sequenceNumber="1">
  <locations>
    <location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="planner" includeSource="true" type="InstallableUnit">
      <unit id="org.eclipse.sdk.feature.group" version="0.0.0"/>
      <!-- Only to compile against: the gradle bundle requires Buildship optionally -->
      <unit id="org.eclipse.buildship.core" version="0.0.0"/>
      <!-- the AI perspective's terminals; the SDK feature does not include the terminal -->
      <unit id="org.eclipse.terminal.control" version="0.0.0"/>
      <unit id="org.eclipse.terminal.connector.process" version="0.0.0"/>
      <repository location="https://download.eclipse.org/releases/2026-09/"/>
    </location>
    <!-- Only to compile against: the ui and git bundles require these optionally, so an
         IDE without EGit still installs, and the git tools report that rather than failing
         to resolve. -->
    <location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="planner" includeSource="true" type="InstallableUnit">
      <unit id="org.eclipse.jgit" version="0.0.0"/>
      <unit id="org.eclipse.egit.core" version="0.0.0"/>
      <repository location="https://download.eclipse.org/egit/updates/"/>
    </location>
    <location includeDependencyDepth="infinite" includeDependencyScopes="compile" includeSource="true"
              label="MCP Java SDK" missingManifest="generate" type="Maven">
      <dependencies>
        <dependency>
          <groupId>io.modelcontextprotocol.sdk</groupId>
          <artifactId>mcp</artifactId>
          <version>2.2.0</version>
          <type>jar</type>
        </dependency>
        <!-- the SDK's pom pins a release candidate of reactor-core -->
        <dependency>
          <groupId>io.projectreactor</groupId>
          <artifactId>reactor-core</artifactId>
          <version>3.9.0</version>
          <type>jar</type>
        </dependency>
        <!-- the SDK's pom pairs Jackson 3.1 with a json-schema-validator that imports Jackson 3.2 -->
        <dependency>
          <groupId>tools.jackson.core</groupId>
          <artifactId>jackson-databind</artifactId>
          <version>3.2.4</version>
          <type>jar</type>
        </dependency>
        <dependency>
          <groupId>tools.jackson.dataformat</groupId>
          <artifactId>jackson-dataformat-yaml</artifactId>
          <version>3.2.4</version>
          <type>jar</type>
        </dependency>
      </dependencies>
    </location>
    <location includeDependencyDepth="infinite" includeDependencyScopes="compile" includeSource="true"
              label="Jetty" missingManifest="generate" type="Maven">
      <dependencies>
        <dependency>
          <groupId>org.eclipse.jetty.ee11</groupId>
          <artifactId>jetty-ee11-servlet</artifactId>
          <version>12.1.12</version>
          <type>jar</type>
        </dependency>
        <dependency>
          <groupId>jakarta.servlet</groupId>
          <artifactId>jakarta.servlet-api</artifactId>
          <version>6.1.0</version>
          <type>jar</type>
        </dependency>
      </dependencies>
    </location>
  </locations>
</target>
