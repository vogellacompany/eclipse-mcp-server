<?xml version="1.0" encoding="UTF-8"?>
<feature
      id="com.vogella.eclipse.mcp.feature"
      label="Eclipse MCP Server"
      version="1.0.0.qualifier"
      provider-name="vogella GmbH"
      plugin="com.vogella.eclipse.mcp.ui">

   <description>
      Turns a running Eclipse IDE into an MCP server, so that external
      LLM clients can query the resolved Java model, the problem markers of the
      incremental builder, the Error Log, the preferences and the current editor
      context. Most tools only read; the few that change something say so.
   </description>

